<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:text="Programming Languages"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- fragment 1: list of languages -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerList"
        android:name="com.example.adaptertest.LanguageListFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- fragment 2: details of the selected language -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerDetail"
        android:name="com.example.adaptertest.LanguageDetailFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
